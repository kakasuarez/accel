# Accel Bot voice (ElevenLabs). Copy to .env.local and fill in. Restart `npm run dev` after editing.
# Free plan: https://elevenlabs.io (no card needed). Profile → API Keys.
# Without a key the bot uses the browser's built-in voice and speech recognition.

ELEVENLABS_API_KEY=

# Optional. Pick a voice in the ElevenLabs Voice Library (filter: English, accent Indian),
# add it to "My Voices", then copy its Voice ID here. Defaults to the premade voice "Sarah".
ELEVENLABS_VOICE_ID=

# Optional overrides.
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STT_MODEL=scribe_v2

# ---- Accel backend (merged from the accel repo) ----

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase: Connect > Transaction pooler (port 6543)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Created at startup if it doesn't exist. Changing the password here later has no effect.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# openrouter or local
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash

# Any OpenAI-style server. On Vercel the URL must be publicly reachable, not localhost.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_API_KEY=
# Set to false if the server rejects JSON mode, as LM Studio does.
# LOCAL_LLM_JSON_MODE=true

# LLM_TIMEOUT_MS=30000
